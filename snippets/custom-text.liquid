{%- liquid
	assign colored = false
	if block.settings.colored
    	assign colored = true
		assign words = block.settings.custom_text | split: ' '
        
        assign renamed_variable_words_5b_0_5d_ = '#198560'
        assign renamed_variable_words_5b_1_5d_ = '#AF021E'
        assign renamed_variable_words_5b_2_5d_ = '#EDBD0F'
    endif
-%}

<div class="section-header text-center">
  <div class="larger-text">
    {%- if colored -%}
    hjsakdh
    {%- for word in words -%}
    <span style="color: {{ words[forloop.index] }};">{{ word }}</span>
    {%- endfor -%}
    {%- else -%}
    asd {{block.block.settings.colored }}
    {{ block.settings.custom_text }}
    {%- endif -%}
  </div>
</div>{%- comment -%}

